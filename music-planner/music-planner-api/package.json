  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^7.2.0",
    "fast-check": "^4.6.0",
    "jest": "^29.7.0",
