    "migrate": "ts-node src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:init": "ts-node src/seeds/seedInit.ts",
    "seed:init:prod": "node dist/seeds/seedInit.js",
    "seed:congregation": "ts-node src/seeds/seedCongregation.ts",
    "seed:congregation:prod": "node dist/seeds/seedCongregation.js",
    "seed:songs": "ts-node src/seeds/seedSongs.ts",
